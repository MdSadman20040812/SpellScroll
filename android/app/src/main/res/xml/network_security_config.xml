<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is permitted only for local development hosts (the emulator
     loopback alias and localhost). The previous manifest set
     android:usesCleartextTraffic="true" globally, which allowed unencrypted
     traffic to any host in a release build. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
